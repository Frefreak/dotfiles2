{
  "layer": "top",
  "position": "top",
  "height": 34,
  "margin-top": 6,
  "margin-left": 8,
  "margin-right": 8,
  "spacing": 4,
  "modules-left": [
    "cffi/niri-islands"
  ],
  "modules-right": [
    "cffi/system-cpu",
    "cffi/system-memory",
    "cffi/system-network",
    "cffi/volume",
    "custom/notifications",
    "cffi/calendar",
    "tray"
  ],
  "custom/notifications": {
    "format": "󰂚",
    "tooltip-format": "Notifications",
    "on-click": "swaync-client -t"
  },
  "tray": {
    "icon-size": 16,
    "spacing": 10
  },
  "modules-center": [
    "niri/window"
  ],
  "niri/window": {
    "max-length": 55
  },
  // Frefreak/niri-islands
  "cffi/niri-islands": {
    "module_path": "{{ .chezmoi.homeDir }}/.config/waybar/niri-islands-8456d64a39ce.so",
    "options": {
      "focus-style": "underline",
      "icon-size": 20,
      "workspace-gap": 6,
      "window-gap": 2,
      "radius": 12
    }
  },
  "cffi/system-cpu": {
    "module_path": "{{ .chezmoi.homeDir }}/.config/waybar/niri-islands-8456d64a39ce.so",
    "options": { "widget": "cpu", "radius": 12 }
  },
  "cffi/system-memory": {
    "module_path": "{{ .chezmoi.homeDir }}/.config/waybar/niri-islands-8456d64a39ce.so",
    "options": { "widget": "memory", "radius": 12 }
  },
  "cffi/system-network": {
    "module_path": "{{ .chezmoi.homeDir }}/.config/waybar/niri-islands-8456d64a39ce.so",
    "options": { "widget": "network", "radius": 12 }
  },
  "cffi/volume": {
    "module_path": "{{ .chezmoi.homeDir }}/.config/waybar/niri-islands-8456d64a39ce.so",
    "options": {
      "widget": "volume"
    }
  },
  "cffi/calendar": {
    "module_path": "{{ .chezmoi.homeDir }}/.config/waybar/niri-islands-8456d64a39ce.so",
    "options": {
      "widget": "calendar"
    }
  }
}
