{
  "layer": "top",
  "position": "top",
  "height": 34,
  "margin-top": 6,
  "margin-left": 8,
  "margin-right": 8,
  "spacing": 4,
  "modules-left": [
    "cffi/niri-islands"
  ],
  "modules-right": [
    "custom/activity",
    "pulseaudio",
    "custom/notifications",
    "clock",
    "tray"
  ],
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟 Muted",
    "format-icons": [
      "󰕿",
      "󰖀",
      "󰕾"
    ],
    "scroll-step": 2,
    "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "tooltip-format": "{desc}"
  },
  "custom/notifications": {
    "format": "󰂚",
    "tooltip-format": "Notifications",
    "on-click": "swaync-client -t"
  },
  "clock": {
    "format": "{:%a %d %b  %H:%M}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>"
  },
  "tray": {
    "icon-size": 16,
    "spacing": 10
  },
  "custom/activity": {
    "exec": "{{ .chezmoi.homeDir }}/.config/waybar/activity-graphs.py",
    "return-type": "json",
    "restart-interval": 3,
    "tooltip": true
  },
  "modules-center": [
    "niri/window"
  ],
  "niri/window": {
    "max-length": 55
  },
  // Frefreak/niri-islands
  "cffi/niri-islands": {
    "module_path": "{{ .chezmoi.homeDir }}/.config/waybar/niri-islands-d0144ac3ed27.so",
    "options": {
      "focus-style": "underline",
      "icon-size": 20,
      "workspace-gap": 6,
      "window-gap": 2,
      "radius": 12
    }
  }
}
