[Unit]
Description=VMware clipboard integration for the graphical session
PartOf=graphical-session.target
After=graphical-session-pre.target niri.service
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
Type=forking
ExecStartPre=/usr/bin/xprop -root _NET_SUPPORTING_WM_CHECK
ExecStart=/usr/bin/vmware-user-suid-wrapper
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
